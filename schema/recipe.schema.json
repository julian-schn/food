{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recipe",
  "type": "object",
  "required": ["id", "title", "lang", "servings", "time", "tags", "ingredients", "steps"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "title": {"type": "string"},
    "lang": {"enum": ["de", "en"]},
    "description": {"type": "string"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["original", "web", "adapted", "person"]},
        "url": {"type": ["string", "null"]},
        "credit": {"type": ["string", "null"]}
      }
    },
    "servings": {"type": "integer", "minimum": 1},
    "time": {
      "type": "object",
      "required": ["active", "passive"],
      "additionalProperties": false,
      "properties": {
        "active": {"type": "integer", "minimum": 0},
        "passive": {"type": "integer", "minimum": 0}
      }
    },
    "tags": {"type": "object", "additionalProperties": {"type": ["array", "string"]}},
    "ingredients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "amount", "unit"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "name": {"type": "string"},
          "amount": {"type": ["number", "null"]},
          "unit": {"enum": ["g", "kg", "ml", "l", "tsp", "tbsp", "pinch", "piece", "to-taste", null]},
          "group": {"type": "string"},
          "optional": {"type": "boolean"},
          "substitute": {"type": "string"}
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "text"],
        "additionalProperties": false,
        "properties": {
          "title": {"type": "string"},
          "text": {"type": "string"},
          "heat": {"type": "integer", "minimum": 1, "maximum": 9},
          "oven": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "temp_c": {"type": "integer"},
              "mode": {"enum": ["ober-unter", "umluft", "grill"]}
            }
          },
          "timer": {"type": "integer", "minimum": 1}
        }
      }
    },
    "notes": {"type": "string"},
    "log": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date"],
        "additionalProperties": false,
        "properties": {
          "date": {"type": "string"},
          "rating": {"type": "integer", "minimum": 1, "maximum": 5},
          "note": {"type": "string"}
        }
      }
    }
  }
}
